# STAGING ONLY. Copy to .env.sales-network-staging; never copy production keys.
SALES_NETWORK_ENV=staging
SALES_NETWORK_STAGING_PROJECT_REF=REPLACE_WITH_STAGING_REF
# Non-secret deny-list identifier, NOT a production credential.
SALES_NETWORK_PRODUCTION_PROJECT_REF=REPLACE_WITH_PRODUCTION_REF
SALES_NETWORK_DEMO_ALLOW_HOST=REPLACE_WITH_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_STAGING_SECRET_KEY
APP_URL=http://localhost:3000
SALES_NETWORK_OBSERVABILITY=true
# Seed/reset only; do NOT put this password in Vercel.
SALES_NETWORK_DEMO_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_12_OR_MORE_CHARS
# Optional: existing active staging machine UUID. Does not change catalog.
SALES_NETWORK_DEMO_MACHINE_ID=
# Explicitly blank to shadow .env.local. Do not configure live messaging.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_NAHUITECH_QUOTE_CONTENT_SID=
TWILIO_CONTENT_SID=
WHATSAPP_DELIVERY_MODE=customer_initiated
